{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Pizza: Build",
      "type": "process",
      "command": "make",
      "args": [],
      "options": { "cwd": "${workspaceFolder}" },
      "windows": {
        "command": "powershell.exe",
        "args": ["-NoProfile", "-File", "${workspaceFolder}/build.ps1"]
      },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Pizza: Run",
      "type": "process",
      "command": "${workspaceFolder}/build/pizza-ordering-system",
      "windows": { "command": "${workspaceFolder}/build/pizza-ordering-system.exe" },
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Pizza: Build",
      "problemMatcher": []
    }
  ]
}
