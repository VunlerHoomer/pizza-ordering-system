{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "process",
      "command": "gcc",
      "args": [
        "-std=c11",
        "-Wall",
        "main.c",
        "input.c",
        "account.c",
        "pizza.c",
        "order.c",
        "file.c",
        "-o",
        "pizza"
      ],
      "windows": {
        "args": [
          "-std=c11",
          "-Wall",
          "main.c",
          "input.c",
          "account.c",
          "pizza.c",
          "order.c",
          "file.c",
          "-o",
          "pizza.exe"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Run",
      "type": "process",
      "command": "${workspaceFolder}/pizza",
      "windows": {
        "command": "${workspaceFolder}/pizza.exe"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Build",
      "problemMatcher": []
    }
  ]
}
